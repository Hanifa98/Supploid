{
  "name": "supploid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit -p tsconfig.server.json",
    "test": "node --import tsx --test tests/api.test.ts tests/limiter.test.ts",
    "test:browser": "playwright test",
    "audit": "node scripts/audit.mjs",
    "pages:dev": "wrangler pages dev dist",
    "launch:check": "node scripts/launch-check.mjs",
    "prebuild": "node scripts/assets.mjs",
    "predev": "node scripts/assets.mjs"
  },
  "dependencies": {
    "astro": "5.18.2",
    "@fontsource-variable/inter": "^5.2.8",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.2",
    "lighthouse": "^12.8.2",
    "tsx": "^4.20.6",
    "wrangler": "^4.45.0"
  }
}
