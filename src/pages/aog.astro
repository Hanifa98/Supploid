---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Field from '../components/Field.astro';
import FormEnd from '../components/FormEnd.astro';
const live=import.meta.env.PUBLIC_FORMS_ENABLED==='true'&&!!import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<Base title="Premium AOG support · 24/7" description="A separate premium service for grounded-aircraft parts requirements, available 24/7. Send your callback number, part number, aircraft type, and email."><div class="aog-page"><PageIntro eyebrow="Premium AOG / Available 24/7" title="Aircraft on ground. Your priority is ours." description="Premium support for an urgent aircraft requirement. Send the essentials and a contact we can reach. Scope and terms are agreed for your request."/><section class="container form-layout"><div><p class="eyebrow" style="color:var(--urgent)">Direct premium AOG contact</p><a class="aog-direct" href="mailto:aog@supploid.com?subject=Premium%20AOG%20request">aog@supploid.com ↗</a><p style="max-width:570px;margin-bottom:32px;font-size:14px">Already have a part list? Email it directly. Include aircraft type, location, required condition, and a callback number.</p><form class="request-form" data-request-form="aog" data-live={String(live)} action="/api/aog" method="post"><fieldset class="form-section"><legend>Start with four details.</legend><div class="field-grid"><Field id="phone" label="Callback phone" type="tel" autocomplete="tel" required maxlength={50}/><Field id="partNumber" label="Part number" required maxlength={120}/><Field id="aircraft" label="Aircraft type" required placeholder="e.g. A320neo"/><Field id="email" label="Email" type="email" autocomplete="email" required maxlength={254}/></div></fieldset><FormEnd kind="aog"/></form></div><aside class="form-aside"><div class="notice notice-urgent"><p class="eyebrow" style="color:var(--urgent)">A separate service</p><h2>Premium. Urgent.<br/>Available 24/7.</h2><p>AOG support has its own scope and commercial terms.</p></div><div><p>For routine sourcing, use the standard RFQ form.</p><p style="margin-top:16px"><a href="/quote/">Request a standard quote ↗</a></p></div></aside></section></div><script src="../scripts/forms.ts"></script></Base>
