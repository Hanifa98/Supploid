---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import QuoteForm from '../components/QuoteForm.astro';
const home = (await getEntry('pages','home'))!;
const { Content } = await render(home);
const steps = [ ['Submit your inquiry','Share the part number or description, quantity, and a message with your requirements. We’ll take it from there.'], ['Confirm the documents','Know which source documents accompany the offered part before making a decision. Supplied from the source, where available.'], ['Arrange the shipment','Agree the delivery plan, inspection requirements, and acceptance terms. Worldwide sourcing, with shipment subject to applicable controls.'] ];
---
<Base title="Aircraft parts & industrial sourcing" description={home.data.description}>
  <section class="hero container">
    <div class="hero-topline"><p class="eyebrow eyebrow-mark">{home.data.eyebrow}</p><span class="index">SUPPLY, WITH PURPOSE.</span></div>
    <div class="hero-grid"><div class="hero-copy"><h1><span><span class="word" style="--word-delay:0ms">Your</span> <span class="word" style="--word-delay:40ms">next</span> <span class="word" style="--word-delay:80ms">part.</span></span><span class="accent"><span class="word" style="--word-delay:120ms">Our</span> <span class="word" style="--word-delay:160ms">priority.</span></span></h1><div class="lead"><Content/></div><div class="actions"><CTA href="/quote/">Request a Quote</CTA><CTA href="/aog/" secondary>Premium AOG</CTA></div><p class="hero-response"><strong>Fast quoting, documentation supplied.</strong></p></div>
    <figure class="hero-art"><picture><source type="image/avif" srcset="/images/assembly-480.avif 480w, /images/assembly-960.avif 960w" sizes="(max-width:600px) 90vw, 46vw"/><img src="/images/assembly-960.webp" srcset="/images/assembly-480.webp 480w, /images/assembly-960.webp 960w" sizes="(max-width:600px) 90vw, 46vw" width="960" height="826" fetchpriority="high" alt="Abstract exploded engineering illustration of precision rings and a shaft."/></picture><figcaption>Technical illustration / not to scale</figcaption></figure></div>
    <div class="hero-foot"><span>SUPPLOID → WORLDWIDE</span><span>AVIATION & AEROSPACE / INDUSTRIAL & GENERAL</span></div>
  </section>
  <section class="container" aria-label="Our approach in brief"><div class="terms-strip"><div><span class="index">01 / RESPONSE</span><strong>Fast quoting,</strong><br/>documentation supplied.</div><div><span class="index">02 / DOCUMENTS</span>Available source documents<br/><strong>confirmed before quoting.</strong></div><div><span class="index">03 / ACCEPTANCE</span>Inspection requirements<br/><strong>agreed in your offer.</strong></div><div><span class="index">04 / URGENT SUPPORT</span>Premium AOG support.<br/><strong>A separate 24/7 service.</strong></div></div></section>
  <section class="container reach-band" aria-label="Our confirmed service commitments"><div class="intro"><p class="eyebrow">Your timeline matters.</p><p>Routine sourcing or an aircraft on the ground. Choose the service that fits the requirement.</p></div><div class="stat"><span class="stat-value">Fast</span><p>Quoting, documentation supplied.</p></div><div class="stat"><span class="stat-value">24<span class="accent">/</span>7</span><p>Premium AOG availability.</p></div></section>
  <section class="section section-rule container" id="process"><div class="process-grid"><div class="process-sticky"><p class="eyebrow">01 / How it works</p><h2>From part number<br/>to <span class="accent">next step.</span></h2><p class="lead">A clear request. A considered offer. The documentation and delivery terms in view.</p><div class="actions"><CTA href="/quote/">Start a request</CTA></div></div><ol class="process-list">{steps.map(([title,body],i)=><li class="process-step" data-step><span class="index">0{i+1}</span><div><h3>{title}</h3><p>{body}</p></div></li>)}</ol></div></section>
  <section class="section section-rule container quote-teaser" id="get-a-quote"><div class="quote-intro"><p class="eyebrow">02 / Get a quote</p><h2>Tell us what<br/><span class="accent">you need.</span></h2><p class="lead" style="font-size:15px;margin-top:22px">A few details to get started. Choose aviation or industrial, and send your inquiry.</p></div><QuoteForm/></section>
  <section class="container"><div class="aog-callout"><div><p class="eyebrow" style="color:var(--urgent)">AIRCRAFT ON GROUND?</p><h2>When the priority changes.</h2><p>Premium AOG support is a separate service, available 24/7. Share the part number, aircraft type, and a contact we can reach.</p></div><CTA href="/aog/" secondary>Get premium AOG support</CTA></div></section>
</Base>
