---
interface Props { id:string; name?:string; label:string; type?:'text'|'number'|'date'|'email'|'tel'|'url'|'textarea'; required?:boolean; placeholder?:string; value?:string; max?:string; min?:string; step?:string; maxlength?:number; options?:readonly (string|{value:string;label:string})[]; full?:boolean; autocomplete?:string; help?:string; field?:string; }
const { id, name=id, label, type='text', required=false, placeholder, value, max, min, step, maxlength=240, options, full=false, autocomplete, help, field } = Astro.props;
const attrs = { id,name,required,'data-field':field,'aria-describedby':`${id}-error${help?` ${id}-help`:''}` };
---
<div class:list={['field',{'field-full':full}]}><label for={id}>{label}{required ? <span aria-hidden="true"> *</span> : <span class="optional"> · optional</span>}</label>{options ? <select {...attrs}>{!required && <option value="">To agree</option>}{required && !value && <option value="">Select</option>}{options.map(o=>{const v=typeof o==='string'?o:o.value;return <option value={v} selected={v===value}>{typeof o==='string'?o:o.label}</option>})}</select> : type==='textarea' ? <textarea {...attrs} placeholder={placeholder} maxlength={maxlength} rows={4}>{value}</textarea> : <input {...attrs} type={type} placeholder={placeholder} value={value} min={min} max={max} step={step} maxlength={maxlength} autocomplete={autocomplete}/>}<p class="field-error" id={`${id}-error`} aria-live="polite"></p>{help && <p class="field-help" id={`${id}-help`}>{help}</p>}</div>
